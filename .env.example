# Copy to .env locally. Generate a private random SECRET_KEY before deployment.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,plotmatrix.in,www.plotmatrix.in
DJANGO_CSRF_TRUSTED_ORIGINS=https://plotmatrix.in,https://www.plotmatrix.in
DJANGO_SITE_URL=https://plotmatrix.in
DJANGO_SECURE_SSL_REDIRECT=True
# Default is SQLite3. Optional DATABASE_URL needs the relevant database driver.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
# SQLITE_PATH=db.sqlite3
